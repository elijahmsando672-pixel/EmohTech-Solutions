# ============================================================
# EmohTech Solutions - Server environment variables
# Copy this file to `.env` and fill in your real values.
# ============================================================

# Port the API runs on (Vite dev server proxies /api here)
PORT=5000

# Client origin allowed by CORS (Dev = Vite, Prod = your domain)
CLIENT_ORIGIN=http://localhost:5173

# ---------- Microsoft SQL Server ----------
# The server runs with an in-memory fallback when the database
# cannot be reached, so the site works even without SQL Server.
# Set ENABLE_MSSQL=true after creating the database (see database/schema.sql).
ENABLE_MSSQL=false
MSSQL_SERVER=localhost
MSSQL_DATABASE=EmohTechDB
MSSQL_USER=sa
MSSQL_PASSWORD=Your_Strong_Password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ---------- Admin / JWT (for viewing submitted messages) ----------
# Used to log in at POST /api/auth/login. Change these!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---------- Email notifications (optional) ----------
# When a form is submitted, an email is sent to NOTIFY_TO via SMTP.
# Leave these blank to run without email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Elijah Musando <elijahmsando672@gmail.com>
NOTIFY_TO=elijahmsando672@gmail.com