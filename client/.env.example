# ============================================================
# EmohTech Solutions - Client environment variables
# Copy this file to `.env` and set values as needed.
# Only variables prefixed with VITE_ are exposed to the browser.
# ============================================================

# Base URL of the API when it is hosted separately from this
# static frontend (Netlify, Vercel, Cloudflare Pages, etc.).
# Leave empty when the API serves the built client itself or when
# using the Vite dev proxy (default: relative "/api" requests).
# Example: VITE_API_URL=https://api.emohtech.co.ke
VITE_API_URL=
